# ============================================================================
# TOPUPKU - ENVIRONMENT VARIABLES (.env.example)
# Salin file ini menjadi .env sebelum menjalankan aplikasi: cp .env.example .env
# JANGAN PERNAH menyimpan kredensial produksi asli di repository!
# ============================================================================

# --- APPLICATION MODE & CORE ---
# Pilih "DEMO" untuk simulasi lokal terisolasi (tanpa API key eksternal)
# Pilih "PRODUCTION" untuk transaksi bisnis nyata dengan Midtrans & Digiflazz asli
APP_MODE="DEMO"
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="TOPUPKU"
TZ="Asia/Jakarta"

# --- DATABASE POSTGRESQL (WAJIB POSTGRESQL - DILARANG SQLITE) ---
DATABASE_URL="postgresql://topupku_user:topupku_secret_password@localhost:5432/topupku_db?schema=public"
DIRECT_URL="postgresql://topupku_user:topupku_secret_password@localhost:5432/topupku_db?schema=public"

# --- AUTHENTICATION & SECURITY ---
AUTH_SECRET="change_this_to_a_64_char_random_hex_secret_in_production_2026_topupku"
SESSION_COOKIE_NAME="topupku_session"
CSRF_SECRET="change_this_csrf_secret_key_for_production_security_998877"
ADMIN_INITIAL_EMAIL="admin@topupku.id"
# Password demo di-generate/di-hash saat seed dijalankan (jangan gunakan di production)
DEMO_SEED_PASSWORD_ENV="TopupkuDemo#2026"

# --- MIDTRANS PAYMENT GATEWAY (QRIS DYNAMIC & CORE API) ---
# MIDTRANS_IS_PRODUCTION="false" (Sandbox) atau "true" (Production)
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_MERCHANT_ID="G000000000"
MIDTRANS_CLIENT_KEY="SB-Mid-client-XXXXXXXXXXXXXXXX"
MIDTRANS_SERVER_KEY="SB-Mid-server-XXXXXXXXXXXXXXXX"
MIDTRANS_SNAP_URL="https://app.sandbox.midtrans.com/snap/v1/transactions"
MIDTRANS_CORE_API_URL="https://api.sandbox.midtrans.com/v2"
MIDTRANS_QRIS_EXPIRY_MINUTES="15"

# --- DIGIFLAZZ SUPPLIER API ---
DIGIFLAZZ_USERNAME="your_digiflazz_username"
DIGIFLAZZ_API_KEY="dev-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
DIGIFLAZZ_WEBHOOK_SECRET="your_digiflazz_webhook_secret"
DIGIFLAZZ_API_URL="https://api.digiflazz.com/v1"
DIGIFLAZZ_DEFAULT_MARGIN_PERCENT="8"

# --- WHATSAPP NOTIFICATION API (Fonnte / Wablas / Official WA Cloud Compatible) ---
WHATSAPP_ENABLED="false"
WHATSAPP_PROVIDER="fonnte"
WHATSAPP_API_URL="https://api.fonnte.com/send"
WHATSAPP_API_TOKEN="your_whatsapp_provider_token"
WHATSAPP_ADMIN_NUMBER="6281234567890"
NEXT_PUBLIC_WHATSAPP_CS="6281234567890"

# --- EMAIL SMTP NOTIFICATION ---
SMTP_ENABLED="false"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="noreply@topupku.id"
SMTP_PASS="your_smtp_app_password"
SMTP_FROM="TOPUPKU Official <noreply@topupku.id>"

# --- RATE LIMITING & MAINTENANCE ---
RATE_LIMIT_MAX_REQUESTS="60"
RATE_LIMIT_WINDOW_SECONDS="60"
MAINTENANCE_MODE="false"
